[Unit]
Description=manager-komodo app git drift (is each host's checkout behind the app repo?)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/manager-komodo
ExecStart=/opt/manager-komodo/scripts/app-git-status.sh
# Needs curl and jq on PATH. No docker work here at all: the host half of the comparison is
# already in Komodo (the Stacks track .git/HEAD and .git/refs/heads/<branch> via config_files, and
# Core refreshes them every resource_poll_interval), so this only talks to two HTTP APIs.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
