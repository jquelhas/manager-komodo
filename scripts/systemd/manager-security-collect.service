[Unit]
Description=manager-komodo: harvest host audit reports through the Komodo couriers
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/manager-komodo
ExecStart=/opt/manager-komodo/scripts/security-collect.sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin
