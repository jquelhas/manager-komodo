.env
docker/traefik/certs/*
!docker/traefik/certs/.gitkeep
# Provisioning store holds short-lived per-host install scripts with baked one-shot keys.
provisioning/store/*
!provisioning/store/.gitkeep

# Homepage runtime logs + auto-generated defaults
docker/homepage/logs/

# Security auditor state: scan output, regenerated on every run, and an inventory of our own
# weaknesses. The POLICY (baseline/*.toml, suppressions.toml) is tracked on purpose — every
# accepted risk should be a reviewable diff.
security/state/*
!security/state/.gitkeep

# Per-run archive of host audit reports (gzipped NDJSON, pruned by SECAUDIT_RETENTION_DAYS).
# Regenerated on every collection, and an inventory of our own weaknesses.
var/secaudit/
