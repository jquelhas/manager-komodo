# Pinned artifacts for the secaudit host bundle. THIS is the file you edit to update the fleet's
# scanners; bootstrap/install-secaudit.sh re-runs idempotently and replaces only what changed.
#
# Every artifact is verified by SHA-256 before it is unpacked. Where upstream publishes an official
# checksum we use theirs (recorded below); where it does not, the hash was computed once over HTTPS
# from the canonical origin and is pinned here forever after — trust-on-first-use at pin time,
# verified on every install since. A hash mismatch aborts the install; it is never a warning.
#
# Sources of the pins, so the next person can re-derive them:
#   trivy   https://github.com/aquasecurity/trivy/releases/download/v0.74.0/trivy_0.74.0_checksums.txt
#   lynis   computed from https://downloads.cisofy.com/lynis/lynis-3.1.7.tar.gz  (CISOfy publishes
#           no detached checksum for the tarball; the origin is HTTPS and the hash is pinned here)
#   bench   computed from the v1.6.1 source archive. Upstream also publishes PER-FILE checksums
#           (docker-bench-security.sha256); the archive hash is one check instead of ~20 and is
#           equivalent as long as this file is reviewed.

# Lynis — OS hardening audit. https://github.com/CISOfy/lynis  (3.1.7, 2026-06-25)
SECAUDIT_LYNIS_VERSION=3.1.7
SECAUDIT_LYNIS_URL=https://downloads.cisofy.com/lynis/lynis-3.1.7.tar.gz
SECAUDIT_LYNIS_SHA256=b5314a07fd85fa3ffc7da57b508f0108ec3280d84e4af823f805d95cbbc2428c

# docker-bench-security — CIS Docker Benchmark. (v1.6.1, released 2023-12-20)
# NOTE: this is the latest RELEASE; the repo is still maintained (commits into 2026) but releases
# are rare. It encodes CIS 1.6.0 while this fleet runs Docker 29.x, so a few checks are dated.
# That is exactly why the alerting uses per-section budgets in security/baseline/bench.toml and
# fires on REGRESSION, never on the absolute count.
SECAUDIT_BENCH_VERSION=v1.6.1
SECAUDIT_BENCH_URL=https://github.com/docker/docker-bench-security/archive/refs/tags/v1.6.1.tar.gz
SECAUDIT_BENCH_SHA256=736111db91d5c11808e015d3980c8cb199dce4d03bf35d897e23b7d87cc25844

# Trivy — CVEs in the images already present on the host. (v0.74.0, 2026-08-14)
SECAUDIT_TRIVY_VERSION=0.74.0
SECAUDIT_TRIVY_URL=https://github.com/aquasecurity/trivy/releases/download/v0.74.0/trivy_0.74.0_Linux-64bit.tar.gz
SECAUDIT_TRIVY_SHA256=2ae6fe3ee734b7fdf11335663e18c75ea12dccc76062f09f164a3b0f8be4371a
